---
import Layout from '../layouts/Layout.astro';
import { school } from '../lib/data';
import { mapsUrl, osmUrl } from '../lib/site';
const subject = encodeURIComponent('Pyetje për shkollën');
---
<Layout section="prindi" title="Kontakti" description="Email, telefon, adresë dhe Facebook i SHFMU “Mitrush Kuteli”, Matiçan, Prishtinë." crumbs={[{ label: 'Kontakti' }]}>
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Kontakti</span>
      <h1>Na kontaktoni</h1>
      <p class="lead">Telefon, email dhe adresa e shkollës.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="contact-actions">
        <a class="btn" href={`tel:${school.telephoneE164}`}>Telefono {school.telephoneDisplay}</a>
        <a class="btn" href={`mailto:${school.email}?subject=${subject}`}>Dërgo email</a>
        <a class="btn ghost" href={mapsUrl} rel="noopener noreferrer" target="_blank">Udhëzime në hartë</a>
      </div>
    </div>
    <div class="container split">
      <div class="card stack">
        <div><h2 style="font-size:1.15rem">Email</h2><p style="margin:0"><a href={`mailto:${school.email}?subject=${subject}`}>{school.email}</a></p></div>
        <div><h2 style="font-size:1.15rem">Telefon</h2><p style="margin:0"><a href={`tel:${school.telephoneE164}`}>{school.telephoneDisplay}</a></p></div>
        <div><h2 style="font-size:1.15rem">Adresa</h2><p style="margin:0">{school.street}<br />{school.location}</p></div>
        <div><h2 style="font-size:1.15rem">Facebook</h2><p style="margin:0"><a href={school.facebook} rel="noopener noreferrer" target="_blank">Faqja e shkollës në Facebook</a> <span class="small muted">(hapet në skedë të re)</span></p></div>
      </div>
      <div class="stack">
        <h2>Udhëzime për ardhje</h2>
        <p>Hapni adresën në hartë.</p>
        <p><a class="btn ghost" href={mapsUrl} rel="noopener noreferrer" target="_blank">Hap në Google Maps</a> <a class="btn ghost" href={osmUrl} rel="noopener noreferrer" target="_blank">Hap në OpenStreetMap</a></p>
        <p class="small muted">Për takime me mësimdhënës shihni <a href="/per-prinder#konsultimet">orarin e konsultimeve</a>.</p>
      </div>
    </div>
  </section>
</Layout>
