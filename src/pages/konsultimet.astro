---
import Layout from '../layouts/Layout.astro';
import ConsultationExplorer from '../components/ConsultationExplorer.astro';
import { school } from '../lib/data';
---
<Layout section="prindi" title="Konsultimet me prindër" description={`Ditët dhe orët kur mësimdhënësit, drejtoresha, sekretari, koordinatorja dhe psikologia takojnë prindërit, viti ${school.currentSchoolYear}.`} crumbs={[{ label: 'Për prindërit', href: '/per-prinder' }, { label: 'Konsultimet' }]}>
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Për prindërit · {school.currentSchoolYear}</span>
      <h1>Konsultimet me prindër</h1>
      <p class="lead">Kur mund t’i takoni mësimdhënësit dhe shërbimet e shkollës. Është orar disponueshmërie, jo sistem rezervimi.</p>
    </div>
  </div>

  <section class="section tight">
    <div class="container">
      <h2 class="sr-only">Orari i takimeve</h2>
      <ConsultationExplorer />

      <div class="callout info" style="margin-top:24px">
        <p><strong>Hasime Mehmeti</strong> shfaqet dy herë, sepse ka dy takime të ndara: si mësimdhënëse e artit muzikor (e enjte 10:20–11:05) dhe si koordinatore (e enjte 11:00–12:00).</p>
        <p>Këto orare nuk janë orar zyre i përgjithshëm. Për pyetje të tjera, <a href="/kontakti">kontaktoni shkollën</a>.</p>
      </div>

      <p class="no-print" style="margin-top:24px">
        <button class="btn ghost small" type="button" id="c-print" hidden>Printo këtë faqe</button>
        <a class="btn ghost small" href="/documents/orari-i-konsultimeve-2026-27.png" download>Shkarko dokumentin origjinal (PNG)</a>
      </p>
    </div>
  </section>
</Layout>
