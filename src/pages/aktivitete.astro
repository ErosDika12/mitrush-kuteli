---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { activities } from '../lib/data';
import { photoById } from '../lib/photos';
---
<Layout section="jeta" title="Jeta shkollore" description="Muzikë, sport dhe aktivitete në natyrë në SHFMU “Mitrush Kuteli”, me fotografi nga shkolla." crumbs={[{ label: 'Jeta shkollore' }]} ogPhoto="foto-5">
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Jeta shkollore</span>
      <h1>Jeta në shkollën tonë</h1>
      <p class="lead">Muzikë, sport dhe aktivitete jashtë klase. Shihni edhe lajmet, klubet dhe galerinë.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      {activities.map((a, i) => (
        <article class:list={['activity', { flip: i % 2 === 1 }]} id={a.id}>
          <div class="ph-col stack">
            {a.photos.map((pid, j) => (
              <figure style="margin:0">
                <div class="ph" style={j === 0 ? '' : 'max-width:70%'}><Photo id={pid} crop sizes="(min-width: 860px) 560px, 100vw" /></div>
                <figcaption class="small muted" style="margin-top:6px">{photoById.get(pid)?.caption}</figcaption>
              </figure>
            ))}
          </div>
          <div class="stack">
            <span class="eyebrow">{a.kind}</span>
            <h2>{a.title}</h2>
            <p class="lead">{a.text}</p>
            <a class="link-arrow" href={`/galeria#${a.id}`}>Shih albumin</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section alt" aria-labelledby="club-teaser">
    <div class="container split">
      <div class="stack">
        <span class="eyebrow">Klubet</span>
        <h2 id="club-teaser">Klube dhe grupe të shkollës</h2>
        <p>Futboll, basketboll, hendboll, shah, kor dhe klube lëndore.</p>
        <a class="btn" href="/klubet">Shih klubet</a>
      </div>
      <div class="photo-band">
        <a class="ph" href="/klubet#sport"><Photo id="basketboll-djemte" sizes="300px" /></a>
        <a class="ph" href="/klubet#sport"><Photo id="futboll-djemte" sizes="300px" /></a>
      </div>
    </div>
  </section>

</Layout>
