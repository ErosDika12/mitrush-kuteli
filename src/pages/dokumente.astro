---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import { documents } from '../lib/data';
import { formatDate, normalize } from '../lib/format';

const categories = [...new Set(documents.map((d) => d.category))];
const years = [...new Set(documents.map((d) => d.schoolYear))];
---
<Layout section="prindi" title="Dokumentet" description="Orare dhe dokumente të SHFMU “Mitrush Kuteli” për shikim dhe shkarkim." crumbs={[{ label: 'Dokumentet' }]}>
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Dokumentet</span>
      <h1>Dokumentet e shkollës</h1>
      <p class="lead">Orare dhe dokumente me titullin origjinal, vitin shkollor dhe formatin e skedarit.</p>
    </div>
  </div>

  <section class="section tight">
    <div class="container">
      <form class="filters" id="d-filters" onsubmit="return false" role="search" aria-label="Filtro dokumentet">
        <div><label for="d-q">Fjalë kyçe</label><input id="d-q" type="search" autocomplete="off" /></div>
        <div><label for="d-cat">Kategoria</label><select id="d-cat"><option value="">Të gjitha</option>{categories.map((c) => <option>{c}</option>)}</select></div>
        <div><label for="d-year">Viti</label><select id="d-year"><option value="">Të gjithë</option>{years.map((y) => <option>{y}</option>)}</select></div>
        <div><button class="btn ghost" type="button" id="d-reset">Pastro</button></div>
      </form>
      <p class="count" id="d-count" aria-live="polite">{documents.length} dokumente.</p>
      <h2 class="sr-only">Lista e dokumenteve</h2>
      <div class="doc-list">
        {documents.map((d) => (
          <article class="doc" data-doc data-cat={d.category} data-year={d.schoolYear} data-search={normalize(`${d.title} ${d.originalTitle} ${d.description} ${d.category}`)}>
            <div>
              <h3>{d.title}</h3>
              <p class="muted" style="margin:0 0 6px">{d.description}</p>
              <p class="meta" style="margin:0">
                <span class="tag">{d.category}</span><span>Viti: {d.schoolYear}</span>{d.date && <span>Data: {formatDate(d.date)}</span>}<span>Format: {d.format}</span>
              </p>
              <p class="small muted" style="margin:6px 0 0">Titulli origjinal: {d.originalTitle}</p>
            </div>
            <div class="doc-actions">
              <a class="btn small" href={d.file} target="_blank" rel="noopener noreferrer">{d.external ? 'Hap burimin' : 'Shiko'}<span class="sr-only"> {d.title} (skedë e re)</span></a>
              {!d.external && <a class="btn ghost small" href={d.file} download>Shkarko {d.format}</a>}
              {d.transcription && <a class="btn ghost small" href={d.transcription}>Version i lexueshëm</a>}
            </div>
          </article>
        ))}
      </div>
      <EmptyState title="Asnjë dokument nuk përputhet" id="d-empty" hidden><p>Pastroni filtrat për të parë të gjitha dokumentet.</p></EmptyState>
    </div>
  </section>

  <script>
    import { normalize } from '../lib/format';
    import { readParams, writeParams } from '../scripts/url-state';
    const q = document.getElementById('d-q') as HTMLInputElement;
    const cat = document.getElementById('d-cat') as HTMLSelectElement;
    const year = document.getElementById('d-year') as HTMLSelectElement;
    const count = document.getElementById('d-count')!;
    const empty = document.getElementById('d-empty')!;
    const docs = Array.from(document.querySelectorAll<HTMLElement>('[data-doc]'));
    function apply() {
      const terms = normalize(q.value).split(/\s+/).filter(Boolean);
      let n = 0;
      for (const d of docs) {
        const ok = terms.every((t) => (d.dataset.search || '').includes(t)) && (!cat.value || d.dataset.cat === cat.value) && (!year.value || d.dataset.year === year.value);
        d.hidden = !ok; if (ok) n++;
      }
      empty.hidden = n > 0;
      count.textContent = `${n} nga ${docs.length} dokumente.`;
    }
    const toUrl = (push: boolean) => writeParams({ q: q.value.trim(), kategoria: cat.value, viti: year.value }, push);
    function fromUrl() { const p = readParams(); q.value = p.get('q') ?? ''; cat.value = p.get('kategoria') ?? ''; year.value = p.get('viti') ?? ''; apply(); }
    q.addEventListener('input', () => { apply(); toUrl(false); });
    cat.addEventListener('change', () => { apply(); toUrl(true); });
    year.addEventListener('change', () => { apply(); toUrl(true); });
    document.getElementById('d-reset')!.addEventListener('click', () => { q.value = ''; cat.value = ''; year.value = ''; apply(); toUrl(true); });
    window.addEventListener('popstate', fromUrl);
    fromUrl();
  </script>
</Layout>
