---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import StaffEntry from '../components/StaffEntry.astro';
import LifeRotator from '../components/LifeRotator.astro';
import VideoBox from '../components/VideoBox.astro';
import { school, staff } from '../lib/data';
import { absoluteUrl } from '../lib/site';
import { photoById } from '../lib/photos';

// Real photograph of the school building (Matiqan). Shown only once supplied: add src/assets/photos/school-building.jpg
// and its entry {"id":"school-building", ...} in src/data/photos.json. Until then the hero is a plain navy block.
const hasBuilding = photoById.has('school-building');

// Only values confirmed by the school are shown; set "confirmed": true in src/data/school.json -> facts once a value is verified.
const facts = school.facts.filter((f) => f.confirmed && f.value);

const team = ['remzije-racaj', 'besnik-mehmeti', 'hasime-mehmeti']
  .map((id) => staff.find((s) => s.id === id)!)
  .map((m) => ({ m, role: m.roles.find((r) => r.group === 'leadership') ?? m.roles[0] }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'School',
  name: school.expandedName,
  alternateName: school.name,
  url: absoluteUrl('/'),
  email: school.email,
  telephone: school.telephoneE164,
  address: { '@type': 'PostalAddress', streetAddress: 'Rr. Sokol Sopi', addressLocality: 'Prishtinë', addressCountry: 'XK' },
  sameAs: [school.facebook],
};
---
<Layout title={school.name} description="SHFMU “Mitrush Kuteli”, shkollë fillore dhe e mesme e ulët në Matiqan, Prishtinë: jeta shkollore, udhëheqja, stafi dhe informacione për prindërit." jsonLd={jsonLd}>
  <section class:list={['hero-wide', { 'has-photo': hasBuilding }]}>
    {hasBuilding && <Photo id="school-building" priority class="hero-bg" sizes="100vw" widths={[640, 960, 1440, 1920]} alt="Objekti i SHFMU “Mitrush Kuteli”" />}
    <div class="container hero-wide-inner">
      <h1>{school.name}</h1>
      <p class="tagline">{school.tagline}</p>
      <p class="lead">Shkollë fillore dhe e mesme e ulët në Matiqan të Prishtinës, ku mësimi, muzika dhe sporti bashkohen në një komunitet të vogël.</p>
      <div class="hero-actions"><a class="btn" href="#shkolla">Njihuni me shkollën</a></div>
    </div>
  </section>

  <section class="section" aria-labelledby="life-h">
    <div class="container">
      <div class="section-head">
        <h2 id="life-h">Jeta shkollore</h2>
        <a class="link-arrow" href="/aktivitete">Të gjitha aktivitetet</a>
      </div>
      <LifeRotator />
    </div>
  </section>

  <VideoBox />

  <section class="section alt" aria-labelledby="staff-h">
    <div class="container">
      <div class="section-head">
        <h2 id="staff-h">Udhëheqja</h2>
        <a class="link-arrow" href="/stafi">I gjithë stafi</a>
      </div>
      <div class="staff-grid leadership preview">
        {team.map(({ m, role }) => <StaffEntry member={m} role={role} />)}
      </div>
    </div>
  </section>

  <div id="shkolla">
    <section class="section" aria-labelledby="id-h">
      <div class="container identity">
        <div class="stack">
          <h2 id="id-h">Identiteti i shkollës</h2>
          <p>{school.expandedName} ndodhet në {school.street}, {school.location}. Motoja jonë, <em>{school.tagline}</em>, përmbledh atë që synojmë çdo ditë: nxënës që nxënë me kënaqësi, krijojnë me guxim dhe e gjejnë vendin e vet.</p>
          <p>Misioni ynë: <strong>{school.mission.text}</strong></p>
          <p>Shkolla ka edhe një <a href="/lajme/dhoma-burimore-arsim-gjitheperfshires">dhomë burimore</a> për mbështetjen e arsimit gjithëpërfshirës.</p>
        </div>
        <aside class="facts" aria-labelledby="facts-h">
          <h3 id="facts-h">Të dhëna kryesore</h3>
          <dl>
            {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
          </dl>
        </aside>
      </div>
    </section>

    <section class="section alt" aria-labelledby="stages-h">
      <div class="container">
        <h2 id="stages-h">Shkallët e arsimit</h2>
        <div class="stage-list">
          {school.stages.map((s) => (
            <article class="stage" id={s.id}>
              <span class="stage-range">{s.range}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="name-h">
      <div class="container prose">
        <h2 id="name-h">Emri i shkollës – Mitrush Kuteli</h2>
        <p>Shkolla jonë mban me krenari emrin e një prej figurave më të rëndësishme të letërsisë shqipe, Mitrush Kutelit, pseudonim letrar i Dhimitër Paskos (1907–1967), shkrimtar, përkthyes dhe ekonomist i shquar shqiptar.</p>
        <p>Mitrush Kuteli zë një vend të veçantë në historinë e letërsisë shqiptare dhe konsiderohet një ndër themeluesit e prozës moderne shqipe. Përmes veprave të tij, si “Netë shqiptare” dhe “Tregime të moçme shqiptare”, ai ruajti dhe pasuroi traditën, kulturën, gjuhën dhe trashëgiminë tonë kombëtare.</p>
        <p>Që nga 20 qershori 1992, shkolla jonë mban emrin e tij, duke e konsideruar këtë emërtim jo vetëm si një nderim për figurën e tij, por edhe si një vlerë dhe përgjegjësi për brezat që edukohen në këtë institucion.</p>
        <p>Emri i Mitrush Kutelit na frymëzon të kultivojmë te nxënësit dashurinë për gjuhën shqipe, leximin, dijen, kulturën dhe identitetin kombëtar. Shkolla jonë synon që, krahas edukimit dhe arsimimit cilësor, të përcjellë te çdo brez vlerat që përfaqëson figura e këtij personaliteti të shquar shqiptar.</p>
      </div>
    </section>
  </div>
</Layout>
