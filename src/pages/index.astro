---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import StaffEntry from '../components/StaffEntry.astro';
import LifeRotator from '../components/LifeRotator.astro';
import VideoBox from '../components/VideoBox.astro';
import { school, staff } from '../lib/data';
import { absoluteUrl } from '../lib/site';
import { photoById } from '../lib/photos';

// Real photograph of the school building (Matiçan). Shown only once supplied: add src/assets/photos/school-building.jpg
// and its entry {"id":"school-building", ...} in src/data/photos.json. Until then the hero is a plain navy block.
const hasBuilding = photoById.has('school-building');

const team = ['remzije-racaj', 'besnik-mehmeti', 'hasime-mehmeti']
  .map((id) => staff.find((s) => s.id === id)!)
  .map((m) => ({ m, role: m.roles.find((r) => r.group === 'leadership') ?? m.roles[0] }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'School',
  name: school.expandedName,
  alternateName: school.name,
  url: absoluteUrl('/'),
  email: school.email,
  telephone: school.telephoneE164,
  address: { '@type': 'PostalAddress', streetAddress: 'Rr. Sokol Sopi', addressLocality: 'Prishtinë', addressCountry: 'XK' },
  sameAs: [school.facebook],
};
---
<Layout title={school.name} description="SHFMU “Mitrush Kuteli”, shkollë fillore dhe e mesme e ulët në Matiçan, Prishtinë: jeta shkollore, udhëheqja, stafi dhe informacione për prindërit." jsonLd={jsonLd}>
  <section class:list={['hero-wide', { 'has-photo': hasBuilding }]}>
    {hasBuilding && <Photo id="school-building" priority class="hero-bg" sizes="100vw" widths={[640, 960, 1440, 1920]} alt="Objekti i SHFMU “Mitrush Kuteli”" />}
    <div class="container hero-wide-inner">
      <h1>{school.name}</h1>
      <p class="tagline">{school.tagline}</p>
      <p class="lead">Shkollë fillore dhe e mesme e ulët në Matiçan të Prishtinës, ku mësimi, muzika dhe sporti bashkohen në një komunitet të vogël.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="life-h">
    <div class="container">
      <div class="section-head">
        <h2 id="life-h">Jeta shkollore</h2>
        <a class="link-arrow" href="/aktivitete">Të gjitha aktivitetet</a>
      </div>
      <LifeRotator />
    </div>
  </section>

  <VideoBox />

  <section class="section alt" aria-labelledby="staff-h">
    <div class="container">
      <div class="section-head">
        <h2 id="staff-h">Udhëheqja</h2>
        <a class="link-arrow" href="/stafi">I gjithë stafi</a>
      </div>
      <div class="staff-grid leadership preview">
        {team.map(({ m, role }) => <StaffEntry member={m} role={role} />)}
      </div>
    </div>
  </section>
</Layout>
