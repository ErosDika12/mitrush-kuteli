---
import Layout from '../../layouts/Layout.astro';

const quiz = [
  { q: 'Në cilin vit u shpall Pavarësia e Shqipërisë?', options: ['1878', '1912', '1920', '1944'], answer: 1 },
  { q: 'Në cilin qytet u shpall Pavarësia më 28 Nëntor?', options: ['Vlorë', 'Shkodër', 'Prizren', 'Durrës'], answer: 0 },
  { q: 'Kush e kryesoi qeverinë e parë shqiptare pas shpalljes së pavarësisë?', options: ['Skënderbeu', 'Ismail Qemali', 'Naim Frashëri', 'Isa Boletini'], answer: 1 },
  { q: 'Si është flamuri kombëtar shqiptar?', options: ['Shqiponjë e zezë dykrenore në fushë të kuqe', 'Shqiponjë e kuqe në fushë të zezë', 'Tre vija: e kuqe, e bardhë, e zezë', 'Shqiponjë e artë në fushë blu'], answer: 0 },
];
---
<Layout title="28 Nëntori" description="28 Nëntori, Dita e Flamurit: një faqe e shkurtër historike dhe një kuiz për nxënësit." crumbs={[{ label: '28 Nëntori' }]}>
  <div class="festive">
    <div class="festive-hero">
      <div class="container">
        <span class="eyebrow" style="color:#f1c0c4">Festë kombëtare</span>
        <h1>28 Nëntori, Dita e Flamurit</h1>
        <p class="lead">Më 28 nëntor 1912, në Vlorë, u shpall Pavarësia e Shqipërisë, nën drejtimin e Ismail Qemalit. Flamuri kuq e zi me shqiponjën dykrenore u bë simbol i kësaj ngjarjeje.</p>
      </div>
    </div>

    <section class="section">
      <div class="container split">
        <div class="prose stack">
          <h2>Pse e kremtojmë</h2>
          <p>28 Nëntori është një ditë për t’u kujtuar se si u shpall shteti shqiptar dhe për të nderuar flamurin që e përfaqëson kombin. Në Kosovë ky përvjetor kremtohet si Dita e Flamurit.</p>
          <p class="small muted">Ky tekst është shkruar për këtë faqe dhe nuk është citim i ndonjë dokumenti zyrtar. Ai pret miratimin e shkollës.</p>
        </div>
        <div>
          <h2>Kuizi i shkurtër</h2>
          <form id="quiz" novalidate>
            {quiz.map((item, qi) => (
              <fieldset class="quiz-q" data-answer={item.answer}>
                <legend>{qi + 1}. {item.q}</legend>
                {item.options.map((o, oi) => (
                  <label><input type="radio" name={`q${qi}`} value={oi} /> {o}</label>
                ))}
                <p class="quiz-fb" hidden role="status"></p>
              </fieldset>
            ))}
            <button class="btn red" type="submit">Kontrollo përgjigjet</button>
            <button class="btn ghost" type="reset" id="quiz-reset">Provo përsëri</button>
            <p id="quiz-score" class="quiz-fb" role="status" aria-live="polite" style="margin-top:16px"></p>
          </form>
        </div>
      </div>
    </section>
  </div>

  <script>
    const form = document.getElementById('quiz') as HTMLFormElement;
    const score = document.getElementById('quiz-score')!;
    const sets = Array.from(form.querySelectorAll<HTMLFieldSetElement>('.quiz-q'));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let ok = 0, answered = 0;
      for (const fs of sets) {
        const picked = fs.querySelector<HTMLInputElement>('input:checked');
        const fb = fs.querySelector<HTMLElement>('.quiz-fb')!;
        fb.hidden = false;
        if (!picked) { fb.textContent = 'Nuk keni zgjedhur përgjigje.'; fb.className = 'quiz-fb no'; continue; }
        answered++;
        const right = Number(picked.value) === Number(fs.dataset.answer);
        if (right) ok++;
        fb.textContent = right ? 'Saktë.' : `Jo e saktë. Përgjigjja e duhur: ${fs.querySelectorAll('label')[Number(fs.dataset.answer)].textContent!.trim()}.`;
        fb.className = 'quiz-fb ' + (right ? 'ok' : 'no');
      }
      score.textContent = `Keni ${ok} përgjigje të sakta nga ${sets.length}${answered < sets.length ? ` (${sets.length - answered} pa përgjigje)` : ''}.`;
    });
    form.addEventListener('reset', () => {
      score.textContent = '';
      sets.forEach((fs) => { const fb = fs.querySelector<HTMLElement>('.quiz-fb')!; fb.hidden = true; fb.textContent = ''; });
    });
  </script>
</Layout>
