---
import Layout from '../layouts/Layout.astro';
import ConsultationExplorer from '../components/ConsultationExplorer.astro';
import { school, bells, documents, news } from '../lib/data';
import { formatDate, timeRange } from '../lib/format';

const shifts = [
  { title: 'Ndërrimi i parë', rows: bells.firstShift },
  { title: 'Ndërrimi i dytë', rows: bells.secondShift },
];
const notices = news.filter((n) => n.category === 'Njoftim');
---
<Layout section="prindi" title="Për prindërit" description="Orari i ziles, konsultimet me mësimdhënësit, dokumentet dhe kontakti për prindërit e SHFMU “Mitrush Kuteli”." crumbs={[{ label: 'Për prindërit' }]}>
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Për prindërit · {school.currentSchoolYear}</span>
      <h1>Për prindërit</h1>
      <p class="lead">Orari i ziles, takimet me mësimdhënësit, dokumentet dhe kontakti, në një vend.</p>
      <nav class="jump" aria-label="Në këtë faqe">
        <a href="#orari">Orari i ziles</a>
        <a href="#konsultimet">Konsultimet</a>
        <a href="#dokumentet">Dokumentet</a>
        <a href="#kontakti">Kontakti</a>
      </nav>
    </div>
  </div>

  <section class="section" id="orari" aria-labelledby="orari-h">
    <div class="container">
      <div class="section-head">
        <div><h2 id="orari-h">Orari i ziles</h2><p class="muted" style="margin:6px 0 0">Sipas dokumentit të nënshkruar më {formatDate(bells.documentDate)}.</p></div>
        <a class="link-arrow" href="/oraret#klasat">Orari mësimor sipas klasave</a>
      </div>
      <div class="bell-grid">
        {shifts.map((s) => (
          <div class="table-wrap" tabindex="0" role="region" aria-label={s.title}>
            <table>
              <caption>{s.title}</caption>
              <thead><tr><th scope="col">Ora</th><th scope="col">Koha</th></tr></thead>
              <tbody>{s.rows.map((r) => <tr><th scope="row">{r.period}</th><td class="num">{timeRange(r.start, r.end)}</td></tr>)}</tbody>
            </table>
          </div>
        ))}
        <div class="table-wrap" tabindex="0" role="region" aria-label="Parafilloret">
          <table>
            <caption>Parafilloret</caption>
            <thead><tr><th scope="col">Grupi</th><th scope="col">Koha</th></tr></thead>
            <tbody>{bells.preschoolGroups.map((g) => <tr><th scope="row">Grupi i {g.group === 'I' ? 'parë' : 'dytë'}</th><td class="num">{timeRange(g.start, g.end)}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
      <p class="small muted" style="margin-top:12px">Cilat klasa mësojnë në cilin ndërrim konfirmohet nga shkolla. <a href="/oraret#zilja">Detaje dhe pushimet</a></p>
    </div>
  </section>

  <section class="section alt" id="konsultimet" aria-labelledby="kons-h">
    <div class="container">
      <div class="section-head">
        <div><h2 id="kons-h">Konsultimet me prindër</h2><p class="muted" style="margin:6px 0 0">Kërkoni mësimdhënësin sipas emrit ose lëndës. Është orar disponueshmërie, jo sistem rezervimi.</p></div>
      </div>
      <ConsultationExplorer />
    </div>
  </section>

  <section class="section" id="dokumentet" aria-labelledby="doc-h">
    <div class="container">
      <div class="section-head">
        <h2 id="doc-h">Dokumentet</h2>
        <a class="link-arrow" href="/dokumente">Të gjitha dokumentet</a>
      </div>
      <ul class="doc-rows">
        {documents.map((d) => (
          <li>
            <div>
              <strong>{d.title}</strong>
              <span class="small muted">{d.schoolYear} · {d.format}</span>
            </div>
            <div class="doc-actions">
              <a class="btn small" href={d.file} target="_blank" rel="noopener noreferrer">{d.external ? 'Hap' : 'Shiko'}<span class="sr-only"> {d.title} (skedë e re)</span></a>
              {!d.external && <a class="btn ghost small" href={d.file} download>Shkarko<span class="sr-only"> {d.title}</span></a>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {notices.length > 0 && (
    <section class="section alt" id="njoftimet" aria-labelledby="notice-h">
      <div class="container">
        <h2 id="notice-h">Njoftimet</h2>
        {notices.map((n) => <p><a href={`/lajme/${n.slug}`}>{n.title}</a></p>)}
      </div>
    </section>
  )}

  <section class="section alt" id="kontakti" aria-labelledby="pc-h">
    <div class="container split">
      <div class="stack">
        <h2 id="pc-h">Kontakti dhe regjistrimi</h2>
        <p>Për regjistrim dhe transferim, kontaktoni sekretarinë e shkollës.</p>
      </div>
      <div class="card contact-card">
        <p><strong>Telefon</strong><br /><a href={`tel:${school.telephoneE164}`}>{school.telephoneDisplay}</a></p>
        <p><strong>Email</strong><br /><a href={`mailto:${school.email}`}>{school.email}</a></p>
        <p><strong>Adresa</strong><br />{school.street}, {school.location}</p>
        <a class="link-arrow" href="/kontakti">Udhëzime për ardhje</a>
      </div>
    </div>
  </section>
</Layout>
