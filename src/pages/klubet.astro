---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { clubs, clubsData } from '../lib/data';

const sport = clubs.filter((c) => c.category.startsWith('Sport') && c.category === 'Sport');
const others = clubs.filter((c) => !sport.includes(c));
---
<Layout section="jeta" title="Klubet" description="Klubet dhe grupet e SHFMU “Mitrush Kuteli”: futboll, basketboll, hendboll, shah, kor dhe klube lëndore." crumbs={[{ label: 'Jeta shkollore', href: '/aktivitete' }, { label: 'Klubet' }]} ogPhoto="futboll-djemte">
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Jeta shkollore</span>
      <h1>Klubet dhe grupet</h1>
      <p class="lead">Klubet e listuara nga shkolla. {clubsData.note} Për pjesëmarrje, kontaktoni shkollën.</p>
    </div>
  </div>

  <section class="section" id="sport" aria-labelledby="sport-h">
    <div class="container club-group">
      <h2 id="sport-h">Sport</h2>
      <div class="club-grid">
        {sport.map((c) => (
          <article class:list={['club', { plain: !c.photo }]} id={c.id}>
            {c.photo && <div class="ph"><Photo id={c.photo} sizes="(min-width: 900px) 380px, 100vw" widths={[400, 700, 1000]} /></div>}
            <div class="club-body">
              <h3>{c.title}</h3>
              {c.context && <p class="small muted">{c.context}</p>}
              {!c.photo && <p class="small muted">Fotografi nuk është dhënë ende.</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" id="lende" aria-labelledby="other-h">
    <div class="container">
      <h2 id="other-h">Kor, klube lëndore dhe grupe të tjera</h2>
      <div class="club-grid">
        {others.map((c) => (
          <article class:list={['club', { plain: !c.photo }]} id={c.id}>
            {c.photo && <div class="ph"><Photo id={c.photo} sizes="(min-width: 900px) 380px, 100vw" widths={[400, 700, 1000]} /></div>}
            <div class="club-body">
              <h3>{c.title}</h3>
              <p class="small muted">{c.category}{c.photo ? '' : ' · fotografi nuk është dhënë ende'}</p>
            </div>
          </article>
        ))}
      </div>
      <p class="small muted" style="margin-top:var(--s3)">Fotografitë e ekipeve tregojnë grupe nxënësish; ato nuk janë dëshmi për rezultate, tituj ose ngjarje të caktuara. Mbledhjet e këshillit nuk publikohen pa përshkrim, datë dhe burim.</p>
    </div>
  </section>
</Layout>
