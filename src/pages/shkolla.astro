---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import StaffEntry from '../components/StaffEntry.astro';
import { Picture } from 'astro:assets';
import { images } from '../lib/photos';
import { consultations } from '../lib/data';
import { timeRange, weekdayList } from '../lib/format';
import { school, history, staff } from '../lib/data';

const director = staff.find((s) => s.id === 'remzije-racaj')!;
const dImg = director.portrait?.approved ? images[director.portrait.file] : undefined;
const dCons = consultations.filter((c) => c.staffId === director.id);
const admin = ['besnik-mehmeti', 'hasime-mehmeti', 'taibe-morina'].map((id) => {
  const m = staff.find((s) => s.id === id)!;
  return { m, role: m.roles.find((r) => r.group === 'leadership') ?? m.roles[0] };
});
---
<Layout title="Rreth shkollës" description="Identiteti, historia, shkallët e arsimit dhe vlerat e SHFMU “Mitrush Kuteli” në Matiçan të Prishtinës." crumbs={[{ label: 'Shkolla' }]}>
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Shkolla</span>
      <h1>Rreth shkollës</h1>
      <p class="lead">{school.expandedName}, në Matiçan të Prishtinës.</p>
    </div>
  </div>

  <section class="mission" aria-labelledby="mission-h">
    <div class="container" style="padding-block: var(--s5)">
      <span class="eyebrow">Misioni</span>
      <h2 id="mission-h" class="sr-only">Misioni i shkollës</h2>
      <blockquote>{school.mission.text}</blockquote>
      <cite>Misioni i shkollës</cite>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="stack">
        <h2>Identiteti</h2>
        <p>Emri i plotë i shkollës është <strong>{school.expandedName}</strong>. Ajo ndodhet në {school.street}, {school.location}. Festa e shkollës është më <strong>{school.schoolDay}</strong>.</p>
        <p>Motoja e shkollës, <em>{school.tagline}</em>, përmbledh atë që synojmë çdo ditë: nxënës që nxënë me kënaqësi, krijojnë me guxim dhe e gjejnë vendin e vet.</p>
        <p class="small muted">Teksti i këtij seksioni është shkruar për këtë faqe dhe pret miratimin e shkollës.</p>
      </div>
      <figure style="margin:0">
        <div style="border-radius:var(--radius);overflow:hidden"><Photo id="foto-3" sizes="(min-width: 900px) 560px, 100vw" /></div>
        <figcaption class="small muted" style="margin-top:8px">Aktivitet në natyrë me nxënës. Një fotografi e objektit të shkollës do të shtohet kur të jepet nga shkolla.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section alt" aria-labelledby="hist-h">
    <div class="container split">
      <div>
        <span class="eyebrow">Historia</span>
        <h2 id="hist-h">Disa pika kyçe</h2>
        <p class="muted">Datat vijnë nga një dokument historik i planit zhvillimor të shkollës. Numrat e nxënësve nga ai dokument nuk përdoren si të dhëna të sotme.</p>
      </div>
      <ol class="timeline">
        {history.map((h) => <li><span class="when">{h.date}</span>{h.text}<br /><span class="small muted">{h.source}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="stages-h">
    <div class="container">
      <h2 id="stages-h">Shkallët e arsimit</h2>
      <div class="grid cols-3">
        {school.stages.map((s) => <div class="card"><h3>{s.title}</h3><p class="muted" style="margin:0">{s.text}</p></div>)}
      </div>
      <p class="small muted" style="margin-top:16px">Ndarja e klasave sipas ndërrimeve konfirmohet nga shkolla dhe nuk paraqitet këtu si rregull.</p>
    </div>
  </section>

  <section class="section alt" aria-labelledby="values-h">
    <div class="container">
      <h2 id="values-h">Vlerat tona</h2>
      <div class="grid cols-3">
        {school.values.map((v) => <div class="card"><h3>{v.title}</h3><p class="muted" style="margin:0">{v.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="space-h">
    <div class="container split">
      <div class="stack">
        <h2 id="space-h">Ambientet</h2>
        <p>Fotografitë tona tregojnë një klasë muzike me tabelë dhe piano elektrike, si dhe aktivitete në ambiente të jashtme. Sipas raportimit publik të marsit 2026, shkolla ka edhe një <a href="/lajme/dhoma-burimore-arsim-gjitheperfshires">dhomë burimore</a> për mbështetjen e arsimit gjithëpërfshirës.</p>
        <p class="small muted">Lista e plotë e ambienteve do të shtohet pasi shkolla ta konfirmojë.</p>
      </div>
      <div style="border-radius:var(--radius);overflow:hidden"><Photo id="foto-2" sizes="(min-width: 900px) 560px, 100vw" /></div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="lead-h">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">Udhëheqja</span><h2 id="lead-h">Drejtoria dhe administrata</h2></div>
        <a class="link-arrow" href="/stafi">I gjithë stafi</a>
      </div>
      <div class="lead-feature">
        <div class="portrait">{dImg ? <Picture src={dImg} alt={`Portret i ${director.displayName}`} widths={[320, 560]} sizes="280px" formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" /> : null}</div>
        <div class="stack">
          <h3 style="font-size:1.6rem;margin:0">{director.displayName}</h3>
          <p class="role muted" style="margin:0">Drejtoreshë e shkollës</p>
          {dCons.map((c) => <p style="margin:0"><strong>Takim me prindër:</strong> {weekdayList(c.weekdays)}, {timeRange(c.start, c.end)}</p>)}
          <p class="small muted">Një mesazh i drejtoreshës nuk është dhënë ende dhe nuk publikohet.</p>
        </div>
      </div>
      <h3 style="margin-top:var(--s5)">Administrata dhe shërbimet</h3>
      <div class="staff-grid leadership">{admin.map(({ m, role }) => <StaffEntry member={m} role={role} />)}</div>
    </div>
  </section>

  <section class="section" aria-labelledby="name-h">
    <div class="container prose">
      <span class="eyebrow">Emri i shkollës</span>
      <h2 id="name-h">Mitrush Kuteli, shkrimtari</h2>
      <p>“Mitrush Kuteli” është pseudonimi letrar i <strong>Dhimitër Paskos</strong> (1907–1967), i lindur më 13 shtator 1907 në Pogradec. Ai konsiderohet, bashkë me Ernest Koliqin, themelues i prozës moderne shqipe. Ndër veprat e tij janë <em>“Netë shqiptare”</em> (1938) dhe <em>“Tregime të moçme shqiptare”</em> (1965).</p>
      <p class="small muted">Burimi: <a href="https://en.wikipedia.org/wiki/Mitrush_Kuteli" rel="noopener noreferrer" target="_blank">Wikipedia, “Mitrush Kuteli”</a> (hapet në skedë të re). Viti i lindjes dhe i vdekjes (1907–1967) përputhet në disa burime; data e saktë e vdekjes ndryshon midis burimeve, ndaj nuk shkruhet këtu.</p>
    </div>
  </section>
</Layout>
