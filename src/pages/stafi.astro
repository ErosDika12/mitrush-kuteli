---
import Layout from '../layouts/Layout.astro';
import StaffEntry from '../components/StaffEntry.astro';
import EmptyState from '../components/EmptyState.astro';
import { staff } from '../lib/data';
import sectionData from '../data/staff-sections.json';

interface Block { title?: string; ids?: string[]; see?: string; seeLabel?: string }
interface Section { id: string; title: string; blocks: Block[] }
const sections = sectionData as Section[];

// Every person must appear in exactly one card of the directory.
const placed = sections.flatMap((s) => s.blocks.flatMap((b) => b.ids ?? []));
const missing = staff.filter((m) => !placed.includes(m.id)).map((m) => m.id);
const dupes = placed.filter((id, i) => placed.indexOf(id) !== i);
const unknown = placed.filter((id) => !staff.some((m) => m.id === id));
if (missing.length || dupes.length || unknown.length) {
  throw new Error(`staff-sections.json mismatch. missing: ${missing}; duplicates: ${dupes}; unknown: ${unknown}`);
}
const byId = new Map(staff.map((m) => [m.id, m]));
const subjects = [...new Set(staff.flatMap((s) => s.subjects))].sort((a, b) => a.localeCompare(b, 'sq'));
const hasPhoto = (id: string) => !!byId.get(id)!.portrait?.approved;
const person = (id: string) => { const m = byId.get(id)!; return { m, role: m.roles[0] }; };
---
<Layout title="Stafi" description="Drejtoria, mësimdhënësit sipas lëndës, arsimi fillor dhe parashkollor dhe shërbimet mbështetëse të SHFMU “Mitrush Kuteli”, me kërkim sipas emrit, lëndës ose rolit."  crumbs={[{ label: 'Stafi' }]}>
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Stafi</span>
      <h1>Njerëzit e shkollës</h1>
      <p class="lead">Kërkoni sipas emrit, lëndës ose rolit. Kartela tregon orarin e takimit me prindër, ku ka.</p>
    </div>
  </div>

  <section class="section tight">
    <div class="container">
      <form class="filters filters-compact" id="staff-filters" method="get" action="/stafi" role="search" aria-label="Kërko në stafin">
        <div>
          <label for="f-q">Emri, lënda ose roli</label>
          <input id="f-q" type="search" name="q" autocomplete="off" placeholder="p.sh. Shkelzen, gjerman, psikologe" />
        </div>
        <div>
          <label for="f-lenda">Lënda</label>
          <select id="f-lenda" name="lenda">
            <option value="">Të gjitha lëndët</option>
            {subjects.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
        <div>
          <label for="f-grupi">Grupi</label>
          <select id="f-grupi" name="grupi">
            <option value="">Të gjithë</option>
            {sections.map((s) => <option value={s.id}>{s.title}</option>)}
          </select>
        </div>
        <div class="filter-actions">
          <button class="btn" type="submit">Kërko</button>
          <button class="btn ghost" type="reset" id="f-reset">Pastro</button>
        </div>
      </form>

      <p class="count" id="staff-count-wrap"><span id="staff-count" aria-live="polite">Po shfaqen {staff.length} nga {staff.length} persona.</span><button class="clear-link" type="button" id="staff-clear" hidden>Pastro filtrat</button></p>

      {sections.map((sec) => (
        <div class="staff-group" data-group-section={sec.id}>
          <h2>{sec.title}</h2>
          <div class:list={['staff-blocks', { multi: sec.blocks.length > 1 }]}>
          {sec.blocks.map((b) => (
            <div class="staff-block" data-block>
              {b.title && <h3 class="subject-h">{b.title}</h3>}
              {b.see ? (
                <p class="see-also" data-see={b.see}>
                  <a href={`#${b.see}`}>{byId.get(b.see)!.displayName}</a> · shih kartën te {b.seeLabel}
                </p>
              ) : (
                <>
                  <div class:list={['staff-grid', sec.id]}>
                    {(b.ids ?? []).filter(hasPhoto).map((id) => <StaffEntry member={person(id).m} role={person(id).role} section={sec.id} hideSubject={!!b.title} />)}
                  </div>
                  <div class="staff-compact">
                    {(b.ids ?? []).filter((id) => !hasPhoto(id)).map((id) => <StaffEntry member={person(id).m} role={person(id).role} section={sec.id} hideSubject={!!b.title} />)}
                  </div>
                </>
              )}
            </div>
          ))}
          </div>
        </div>
      ))}

      <EmptyState title="Nuk u gjet asnjë person" id="staff-empty" hidden>
        <p>Provoni një shkrim tjetër ose pastroni filtrat.</p>
        <button class="btn" type="button" id="staff-empty-reset">Pastro filtrat</button>
      </EmptyState>
    </div>
  </section>

  <script>
    import { normalize } from '../lib/format';
    import { readParams, writeParams } from '../scripts/url-state';

    const form = document.getElementById('staff-filters') as HTMLFormElement;
    const q = document.getElementById('f-q') as HTMLInputElement;
    const lenda = document.getElementById('f-lenda') as HTMLSelectElement;
    const grupi = document.getElementById('f-grupi') as HTMLSelectElement;
    const count = document.getElementById('staff-count')!;
    const clearBtn = document.getElementById('staff-clear') as HTMLButtonElement;
    const empty = document.getElementById('staff-empty')!;
    const people = Array.from(document.querySelectorAll<HTMLElement>('[data-person]'));
    const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-block]'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-group-section]'));
    const total = new Set(people.map((p) => p.dataset.id)).size;

    function apply() {
      const terms = normalize(q.value).split(/\s+/).filter(Boolean);
      const seen = new Set<string>();
      for (const p of people) {
        const hay = p.dataset.search || '';
        const ok =
          terms.every((t) => hay.includes(t)) &&
          (!lenda.value || (p.dataset.subjects || '').split('|').includes(lenda.value)) &&
          (!grupi.value || p.dataset.group === grupi.value);
        p.hidden = !ok;
        if (ok) seen.add(p.dataset.id!);
      }
      // A cross-reference (e.g. music teacher) shows only while the card it points to is shown and no group filter hides it.
      for (const l of document.querySelectorAll<HTMLElement>('[data-see]')) {
        const target = document.getElementById(l.dataset.see!);
        l.hidden = !target || target.hidden || !!grupi.value;
      }
      for (const b of blocks) b.hidden = !b.querySelector('[data-person]:not([hidden]), [data-see]:not([hidden])');
      for (const s of sections) s.hidden = !s.querySelector('[data-block]:not([hidden])');
      empty.hidden = seen.size > 0;
      clearBtn.hidden = seen.size === 0 || !(q.value || lenda.value || grupi.value);
      count.textContent = seen.size
        ? `Po shfaqen ${seen.size} nga ${total} persona.`
        : `Asnjë rezultat nga ${total} persona.`;
    }
    function fromUrl() {
      const p = readParams();
      q.value = p.get('q') ?? '';
      lenda.value = p.get('lenda') ?? '';
      grupi.value = p.get('grupi') ?? '';
      apply();
    }
    function toUrl(push: boolean) { writeParams({ q: q.value.trim(), lenda: lenda.value, grupi: grupi.value }, push); }
    function reset() { q.value = ''; lenda.value = ''; grupi.value = ''; apply(); toUrl(true); q.focus(); }

    q.addEventListener('input', () => { apply(); toUrl(false); });
    lenda.addEventListener('change', () => { apply(); toUrl(true); });
    grupi.addEventListener('change', () => { apply(); toUrl(true); });
    form.addEventListener('submit', (e) => { e.preventDefault(); apply(); toUrl(true); });
    form.addEventListener('reset', (e) => { e.preventDefault(); reset(); });
    document.getElementById('staff-empty-reset')!.addEventListener('click', reset);
    clearBtn.addEventListener('click', reset);
    window.addEventListener('popstate', fromUrl);
    fromUrl();
  </script>
</Layout>
