---
import Photo from './Photo.astro';
import home from '../data/home.json';
const slides = home.slides;
const interval = home.rotatorIntervalMs;
---
<section class="rot" id="life-rotator" aria-roledescription="karusel" aria-label="Jeta shkollore" data-interval={interval}>
  <div class="rot-stage" id="rot-stage" tabindex="0" aria-live="off">
    {slides.map((s, i) => (
      <article class:list={['rot-slide', { active: i === 0 }]} aria-roledescription="pamje" aria-label={`${i + 1} nga ${slides.length}`} data-slide>
        <a class="rot-photo" href={s.href} tabindex="-1" aria-hidden="true">
          <Photo id={s.photo} focus={s.focus} sizes="(min-width: 960px) 1100px, 100vw" widths={[480, 800, 1200]} alt="" />
        </a>
        <div class="rot-text">
          <span class="rot-field">{s.field}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <a class="link-arrow" href={s.href}>Shih më shumë<span class="sr-only">: {s.title}</span></a>
        </div>
      </article>
    ))}
  </div>
  <div class="rot-controls">
    <button type="button" class="rot-btn" id="rot-prev" aria-label="Pamja e mëparshme">←</button>
    <div class="rot-dots" role="group" aria-label="Zgjidh pamjen">
      {slides.map((s, i) => <button type="button" class="rot-dot" data-dot={i} aria-label={`Pamja ${i + 1}: ${s.title}`} aria-current={i === 0 ? 'true' : undefined}><span></span></button>)}
    </div>
    <button type="button" class="rot-btn" id="rot-next" aria-label="Pamja tjetër">→</button>
    <button type="button" class="rot-btn rot-pause" id="rot-pause" aria-pressed="false">Ndalo</button>
  </div>
  <p class="sr-only" id="rot-live" aria-live="polite"></p>
</section>

<script>
  const root = document.getElementById('life-rotator')!;
  const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
  const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
  const stage = document.getElementById('rot-stage')!;
  const pauseBtn = document.getElementById('rot-pause') as HTMLButtonElement;
  const live = document.getElementById('rot-live')!;
  const interval = Number(root.dataset.interval) || 6000;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  let cur = 0, timer: number | undefined, userPaused = reduced.matches, hovering = false, focused = false, touching = false;
  root.classList.add('is-js');

  function show(i: number, announce = false) {
    cur = (i + slides.length) % slides.length;
    slides.forEach((s, k) => { s.classList.toggle('active', k === cur); s.toggleAttribute('inert', k !== cur); });
    dots.forEach((d, k) => (k === cur ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    if (announce) live.textContent = `Pamja ${cur + 1} nga ${slides.length}: ${slides[cur].querySelector('h3')!.textContent}`;
  }
  const paused = () => userPaused || hovering || focused || touching || document.hidden;
  function schedule() {
    window.clearTimeout(timer);
    if (!paused()) timer = window.setTimeout(() => { show(cur + 1); schedule(); }, interval);
  }
  function syncButton() { pauseBtn.textContent = userPaused ? 'Vazhdo' : 'Ndalo'; pauseBtn.setAttribute('aria-pressed', String(userPaused)); }

  document.getElementById('rot-prev')!.addEventListener('click', () => { show(cur - 1, true); schedule(); });
  document.getElementById('rot-next')!.addEventListener('click', () => { show(cur + 1, true); schedule(); });
  dots.forEach((d, k) => d.addEventListener('click', () => { show(k, true); schedule(); }));
  pauseBtn.addEventListener('click', () => { userPaused = !userPaused; syncButton(); schedule(); });
  root.addEventListener('mouseenter', () => { hovering = true; schedule(); });
  root.addEventListener('mouseleave', () => { hovering = false; schedule(); });
  root.addEventListener('focusin', () => { focused = true; schedule(); });
  root.addEventListener('focusout', () => { focused = false; schedule(); });
  document.addEventListener('visibilitychange', schedule);
  reduced.addEventListener('change', () => { if (reduced.matches) { userPaused = true; syncButton(); } schedule(); });
  stage.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { show(cur - 1, true); schedule(); e.preventDefault(); }
    if (e.key === 'ArrowRight') { show(cur + 1, true); schedule(); e.preventDefault(); }
  });
  // Swipe
  let x0 = 0, y0 = 0;
  stage.addEventListener('touchstart', (e) => { touching = true; x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; schedule(); }, { passive: true });
  stage.addEventListener('touchend', (e) => {
    touching = false;
    const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
    if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2) show(cur + (dx < 0 ? 1 : -1), true);
    schedule();
  });
  stage.addEventListener('touchcancel', () => { touching = false; schedule(); });
  show(0);
  syncButton();
  schedule();
</script>
