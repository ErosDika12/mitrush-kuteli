---
import { sections, isOn, type SectionId } from '../lib/site';
interface Props { section: SectionId }
const { section } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const s = sections[section];
---
<nav class="section-nav" aria-label={`Në ${s.title}`}>
  <div class="container">
    <ul>
      {s.items.map((it) => (
        <li><a href={it.href} aria-current={it.match && isOn(path, it.match) ? 'page' : undefined}>{it.label}</a></li>
      ))}
    </ul>
  </div>
</nav>
