---
import { Picture } from 'astro:assets';
import home from '../data/home.json';
import { images } from '../lib/photos';
// Configure in src/data/home.json -> video. Put the file in public/video/ and set "src" (e.g. "/video/ambientet.mp4")
// and optionally "poster" (e.g. "/video/ambientet.jpg"). With no video the box shows a plain static panel. There is no Play button until a real video is configured.
const v = home.video;
---
<section class="vbox-sec" aria-labelledby="video-h">
  <div class="container">
    <h2 id="video-h">{v.title}</h2>
    <div class="vbox">
      {v.src ? (
        <video controls preload="none" playsinline poster={v.poster || undefined} aria-label={v.title}>
          <source src={v.src} type="video/mp4" />
        </video>
      ) : v.poster ? (
        <img src={v.poster} alt="" loading="lazy" decoding="async" />
      ) : (
        <div class="vbox-static">
          <Picture src={images['stema']} alt="" widths={[120, 240]} sizes="72px" formats={['webp']} loading="lazy" class="vbox-crest" />
          <p class="vbox-name">SHFMU “Mitrush Kuteli”</p>
          <p class="vbox-sub">{v.caption}</p>
        </div>
      )}
    </div>
  </div>
</section>
