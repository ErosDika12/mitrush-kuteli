---
// Searchable parent-consultation list (name/subject, day, type). Used on /per-prinder and /konsultimet.
import ConsultationTable from './ConsultationTable.astro';
import EmptyState from './EmptyState.astro';
import { consultations, school, staffById } from '../lib/data';
import { WEEKDAYS } from '../lib/format';

const teaching = consultations.filter((c) => c.context === 'teaching')
  .sort((a, b) => staffById.get(a.staffId)!.subjects[0].localeCompare(staffById.get(b.staffId)!.subjects[0], 'sq') || staffById.get(a.staffId)!.displayName.localeCompare(staffById.get(b.staffId)!.displayName, 'sq'));
const admin = consultations.filter((c) => c.context !== 'teaching');
const adminOrder = ['administration', 'coordination', 'psychology', 'support'];
admin.sort((a, b) => adminOrder.indexOf(a.context) - adminOrder.indexOf(b.context));
---
<form class="filters filters-compact" id="c-filters" role="search" aria-label="Filtro konsultimet" onsubmit="return false">
  <div>
    <label for="c-q">Emri ose lënda</label>
    <input id="c-q" type="search" autocomplete="off" placeholder="p.sh. Akter, biologji, psikologe" />
  </div>
  <div>
    <label for="c-day">Dita</label>
    <select id="c-day">
      <option value="">Të gjitha ditët</option>
      {Object.entries(WEEKDAYS).map(([k, v]) => <option value={k}>{v}</option>)}
    </select>
  </div>
  <div>
    <label for="c-role">Lloji</label>
    <select id="c-role">
      <option value="">Të gjitha</option>
      <option value="teaching">Mësimdhënës</option>
      <option value="admin">Administratë dhe shërbime</option>
    </select>
  </div>
  <div class="filter-actions"><button class="btn ghost" type="button" id="c-reset">Pastro</button></div>
</form>
<p class="count"><span id="c-count" aria-live="polite">{consultations.length} orare takimesh.</span><button class="clear-link" type="button" id="c-clear" hidden>Pastro filtrat</button></p>

<div class="stack" style="--gap:32px">
  <section id="sec-admin" aria-labelledby="h-admin">
    <h3 id="h-admin">Administrata dhe shërbimet</h3>
    <ConsultationTable id="tbl-admin" caption={`Takime me administratën dhe shërbimet, ${school.currentSchoolYear}`} records={admin} showSubject={false} />
  </section>
  <section id="sec-teaching" aria-labelledby="h-teaching">
    <h3 id="h-teaching">Mësimdhënësit</h3>
    <ConsultationTable id="tbl-teaching" caption={`Takime me mësimdhënësit, ${school.currentSchoolYear}`} records={teaching} />
  </section>
</div>

<EmptyState title="Asnjë konsultim nuk përputhet" id="c-empty" hidden>
  <p>Provoni një emër tjetër ose pastroni filtrat.</p>
</EmptyState>

<script>
  import { normalize } from '../lib/format';
  import { readParams, writeParams } from '../scripts/url-state';
  const q = document.getElementById('c-q') as HTMLInputElement;
  const day = document.getElementById('c-day') as HTMLSelectElement;
  const role = document.getElementById('c-role') as HTMLSelectElement;
  const count = document.getElementById('c-count')!;
  const clearBtn = document.getElementById('c-clear') as HTMLButtonElement;
  const empty = document.getElementById('c-empty')!;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-consult]'));
  const secAdmin = document.getElementById('sec-admin')!;
  const secTeach = document.getElementById('sec-teaching')!;

  function apply() {
    const terms = normalize(q.value).split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const r of rows) {
      const inTeach = !!r.closest('#sec-teaching');
      const ok =
        terms.every((t) => (r.dataset.search || '').includes(t)) &&
        (!day.value || (r.dataset.days || '').split(',').includes(day.value)) &&
        (!role.value || (role.value === 'teaching') === inTeach);
      r.hidden = !ok;
      if (ok) shown++;
    }
    for (const s of [secAdmin, secTeach]) s.hidden = !s.querySelector('[data-consult]:not([hidden])');
    empty.hidden = shown > 0;
    clearBtn.hidden = shown === 0 || !(q.value || day.value || role.value);
    count.textContent = shown ? `${shown} nga ${rows.length} orare takimesh.` : `Asnjë rezultat nga ${rows.length} orare takimesh.`;
  }
  const toUrl = (push: boolean) => writeParams({ q: q.value.trim(), dita: day.value, lloji: role.value }, push);
  function fromUrl() { const p = readParams(); q.value = p.get('q') ?? ''; day.value = p.get('dita') ?? ''; role.value = p.get('lloji') ?? ''; apply(); }
  q.addEventListener('input', () => { apply(); toUrl(false); });
  day.addEventListener('change', () => { apply(); toUrl(true); });
  role.addEventListener('change', () => { apply(); toUrl(true); });
  document.getElementById('c-reset')!.addEventListener('click', () => { q.value = ''; day.value = ''; role.value = ''; apply(); toUrl(true); });
  clearBtn.addEventListener('click', () => { q.value = ''; day.value = ''; role.value = ''; apply(); toUrl(true); });
  const print = document.getElementById('c-print') as HTMLButtonElement | null;
  if (print) { print.hidden = false; print.addEventListener('click', () => window.print()); }
  window.addEventListener('popstate', fromUrl);
  fromUrl();
</script>
