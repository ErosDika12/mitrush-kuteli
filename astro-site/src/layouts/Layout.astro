---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionNav from '../components/SectionNav.astro';
import type { SectionId } from '../lib/site';
import { school } from '../lib/data';
import { ALLOW_INDEXING, absoluteUrl, SITE_URL, GOOGLE_SITE_VERIFICATION } from '../lib/site';
import { getImage } from 'astro:assets';
import { photoById } from '../lib/photos';

interface Props {
  title: string;
  description: string;
  crumbs?: { label: string; href?: string }[];
  ogPhoto?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  banner?: boolean;
  section?: SectionId;
}
const { title, description, crumbs, ogPhoto = 'foto-2', noindex = false, jsonLd, banner = false, section } = Astro.props;
const fullTitle = title === school.name ? title : `${title} | ${school.name}`;
const path = Astro.url.pathname;
const canonical = absoluteUrl(path);
const og = photoById.get(ogPhoto);
const ogImg = og && SITE_URL ? await getImage({ src: og.src, width: 1200, format: 'jpg' }) : null;
const robots = !ALLOW_INDEXING || noindex ? 'noindex, nofollow' : 'index, follow';
const b = school.seasonalBanner;
---
<!doctype html>
<html lang="sq">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#17243B" />
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sq_AL" />
    <meta property="og:site_name" content={school.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImg && <meta property="og:image" content={new URL(ogImg.src, SITE_URL + '/').toString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Kalo te përmbajtja</a>
    {banner && b && (
      <aside class="banner" aria-label="Njoftim sezonal" id="season-banner" hidden data-from={b.from} data-to={b.to}>
        <a href={b.href}><span>{b.text}</span><span aria-hidden="true">→</span></a>
      </aside>
    )}
    <Header />
    {section && <SectionNav section={section} />}
    <main id="main" tabindex="-1">
      {crumbs && <Breadcrumbs items={crumbs} />}
      <slot />
    </main>
    <Footer />
    <script>
      // Mobile menu: five links in a vertical list. Without JS the footer carries the same links.
      const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
      const nav = document.getElementById('primary-nav');
      const mq = window.matchMedia('(min-width: 1040px)');

      const header = document.querySelector<HTMLElement>('.site-header');
      function setDrawer(open: boolean, returnFocus = false) {
        if (!toggle || !nav) return;
        if (open && header) nav.style.setProperty('--nav-top', Math.max(0, Math.round(header.getBoundingClientRect().bottom)) + 'px');
        nav.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', String(open));
        document.documentElement.classList.toggle('lock', open && !mq.matches);
        if (!open && returnFocus) toggle.focus();
      }
      toggle?.addEventListener('click', () => setDrawer(toggle.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setDrawer(false, true);
      });
      mq.addEventListener('change', () => setDrawer(false));
      // Following any link in the drawer (also in-page #anchors) closes it and releases the scroll lock.
      nav?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a[href]')) setDrawer(false); });
      // Back/forward cache must never restore a locked page.
      window.addEventListener('pageshow', () => setDrawer(false));
      // Keep focus inside the open drawer on phones.
      nav?.addEventListener('keydown', (e) => {
        if (e.key !== 'Tab' || mq.matches || toggle?.getAttribute('aria-expanded') !== 'true') return;
        const items = [toggle!, ...nav.querySelectorAll<HTMLElement>('a[href], button, input')];
        const first = items[0], last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });

      // Seasonal banner: shown only inside its configured window (Kosovo wall time).
      const banner = document.getElementById('season-banner');
      if (banner) {
        try {
          const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Belgrade' }).format(new Date());
          if (today >= banner.dataset.from! && today <= banner.dataset.to!) banner.hidden = false;
        } catch { /* leave hidden */ }
      }
    </script>
  </body>
</html>
