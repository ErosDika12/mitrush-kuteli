---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { clubs } from '../lib/data';
import { photoById } from '../lib/photos';
const isWide = (id: string) => { const p = photoById.get(id); return !!p && p.src.width / p.src.height > 1.7; };

const sport = clubs.filter((c) => c.category.startsWith('Sport') && c.category === 'Sport');
const others = clubs.filter((c) => !sport.includes(c));
---
<Layout section="jeta" title="Klubet" description="Klubet dhe grupet e SHFMU “Mitrush Kuteli”: futboll, basketboll, hendboll, shah, kor dhe klube lëndore." crumbs={[{ label: 'Jeta shkollore', href: '/aktivitete' }, { label: 'Klubet' }]} ogPhoto="futboll-djemte">
  <div class="page-head">
    <div class="container">
      <span class="eyebrow">Jeta shkollore</span>
      <h1>Klubet dhe grupet</h1>
      <p class="lead">Sport, kor dhe klube lëndore. Për pjesëmarrje, kontaktoni shkollën.</p>
    </div>
  </div>

  <section class="section" id="sport" aria-labelledby="sport-h">
    <div class="container club-group">
      <h2 id="sport-h">Sport</h2>
      <div class="club-grid">
        {sport.map((c) => (
          <article class:list={['club', { plain: !c.photo }]} id={c.id}>
            {c.photo && <div class:list={['ph', { wide: isWide(c.photo) }]}><Photo id={c.photo} sizes="(min-width: 900px) 380px, 100vw" widths={[400, 700, 1000]} /></div>}
            <div class="club-body">
              <h3>{c.title}</h3>
              {!c.photo && <p class="small muted">{c.group ? `Grupi i ${c.group}` : c.category}</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" id="lende" aria-labelledby="other-h">
    <div class="container">
      <h2 id="other-h">Kor, klube lëndore dhe grupe të tjera</h2>
      <div class="club-grid">
        {others.map((c) => (
          <article class:list={['club', { plain: !c.photo }]} id={c.id}>
            {c.photo && <div class:list={['ph', { wide: isWide(c.photo) }]}><Photo id={c.photo} sizes="(min-width: 900px) 380px, 100vw" widths={[400, 700, 1000]} /></div>}
            <div class="club-body">
              <h3>{c.title}</h3>
              <p class="small muted">{c.category}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
